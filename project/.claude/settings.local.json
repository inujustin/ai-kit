{
  "permissions": {
    "allow": [
      "Bash(bash .ai/verify.sh)",
      "Bash(bash .ai/verify.sh *)",
      "Bash(bash .ai/check_antipatterns.sh *)",
      "Bash(bash .ai/bin/newsession *)",
      "Bash(bash .ai/bin/dispatch *)",
      "Bash(bash .ai/bin/gate *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list *)"
    ],
    "ask": [
      "Bash(bash .ai/bin/mergesession *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git clean *)",
      "Bash(git tag *)",
      "Bash(git pull *)",
      "Bash(git remote *)",
      "Bash(git branch -D *)",
      "Bash(git worktree remove *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/site_config.json)",
      "Read(./**/common_site_config.json)",
      "Read(./**/*.xlsx)",
      "Read(./**/*.xls)",
      "Read(./**/*.csv)",
      "Read(./**/*.sql)",
      "Read(./**/*.sql.gz)",
      "Read(./**/*.dump)",
      "Read(./**/*.bak)",
      "Read(./**/backups/**)"
    ]
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.ai/hooks/guard-git.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.ai/hooks/after-edit.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.ai/hooks/stop-gate.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.ai/hooks/session-start.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.ai/hooks/prompt-skills.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "PONYTAIL_DEFAULT_MODE": "lite"
  }
}
