#!/usr/bin/env bash
# Direct mode: bring one reviewed ai/* branch (a Codex or subagent ticket) onto the user's current feature branch as ONE
# commit in the project's commit style. The ai/* branch is kept for tracing. Never switches branch.
# Usage: bash $KIT/.ai/bin/land <ai-branch> "<subject>" ["<body>"]
# Undo (before pushing): git reset --soft HEAD~1 && git restore --staged .
set -euo pipefail
# shellcheck source=/dev/null
. "$(dirname "$0")/../lib.sh"
src="${1:?usage: land <ai-branch> \"<subject>\" [\"<body>\"]}"; subj="${2:?subject required}"; body="${3:-}"
case "$src" in ai/*) ;; *) echo "Only ai/* branches can be landed." >&2; exit 1 ;; esac
cd "$ROOT"
cur="$(git branch --show-current)"
PROTECTED_BRANCHES='^(main|master|develop|dev|release.*|production|staging)$'
# shellcheck source=/dev/null
[ -f "$KIT/.ai/mode.conf" ] && . "$KIT/.ai/mode.conf"
printf '%s' "$cur" | grep -qE "$PROTECTED_BRANCHES" && { echo "You are on protected branch '$cur'." >&2; exit 1; }
[ -z "$(git status --porcelain --untracked-files=no)" ] || { echo "Uncommitted changes on $cur: commit or ask the user first." >&2; exit 1; }
# shellcheck source=/dev/null
. "$KIT/.ai/commit-style.conf"
printf '%s' "$subj" | grep -qE "$SUBJECT_ERE" || { echo "Subject does not match commit-style.conf ($COMMIT_STYLE_SOURCE)." >&2; exit 1; }
base="$(git merge-base "$cur" "$src")"
git diff --binary "$base" "$src" | git apply --index --3way || { echo "Does not apply cleanly on $cur. Rebase the ticket or ask the user." >&2; git reset -q --merge; exit 1; }
git commit -q -m "$subj" ${body:+-m "$body"} -m "Landed from $src ($(git rev-parse --short "$src"))

Co-Authored-By: Claude <noreply@anthropic.com>"
echo "Landed $src on $cur: $(git log -1 --format='%h %s')"
