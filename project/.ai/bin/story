#!/usr/bin/env bash
# Turn the work on an ai/* branch into a clean story of commits on top of the user's branch, instead of one squash.
#   bash .ai/bin/story start <ai-branch>   new branch ai/story/<name> from the user's current branch, in .worktrees/story-<name>;
#                                           records the exact end result the story must reach; prints the changes to tell
#   (Claude builds the commits in that worktree: one logical step each, see .ai/WORKFLOW.md "Story commits")
#   bash .ai/bin/story check  [story-branch] end result identical to the source branch's, every commit passes
#                                           verify --fast, every subject follows Conventional Commits
#   bash .ai/bin/story finish [story-branch] runs check, then fast-forwards the user's branch onto the story (ask the user first)
# The source ai/* branch is kept, so the raw history stays traceable. Undo finish (before pushing): git reset --hard ORIG_HEAD
set -euo pipefail
root="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"
cmd="${1:?usage: story start <ai-branch> | check [story-branch] | finish [story-branch]}"
# Commit style: .ai/commit-style.conf (set from the team's convention during onboarding).
# shellcheck source=/dev/null
. "$root/.ai/commit-style.conf"

story_branch() {
  if [ -n "${1:-}" ]; then echo "$1"; return; fi
  local b; b="$(git branch --show-current)"
  case "$b" in ai/story/*) echo "$b" ;; *) echo "Run inside the story worktree or pass the story branch." >&2; exit 1 ;; esac
}

case "$cmd" in
start)
  src="${2:?usage: story start <ai-branch>}"
  case "$src" in ai/*) ;; *) echo "Source must be an ai/* branch." >&2; exit 1 ;; esac
  target="$(git -C "$root" branch --show-current)"
  case "$target" in ai/*|"") echo "Main folder is on '$target'. Check out your working branch first." >&2; exit 1 ;; esac
  # The end result the story must reach: the source merged onto the target (identical to the source if no divergence).
  if ! tree="$(git -C "$root" merge-tree --write-tree "$target" "$src" | head -1)"; then
    echo "The source conflicts with $target. Rebase or fix the source branch first." >&2; exit 1
  fi
  name="$(date +%F)-$(echo "${src#ai/}" | tr '/' '-' | sed 's/^[a-z]*-//')"
  story="ai/story/$name"
  wt="$root/.worktrees/story-$name"
  git -C "$root" worktree add -q -b "$story" "$wt" "$target"
  git -C "$root" config "branch.$story.storysource" "$src"
  git -C "$root" config "branch.$story.storytarget" "$target"
  git -C "$root" config "branch.$story.storytree" "$tree"
  git -C "$root" config "branch.$story.aibase" "$target"
  for f in AGENTS.md CLAUDE.local.md; do [ -f "$root/$f" ] && cp "$root/$f" "$wt/$f"; done
  ln -s "$root/.ai" "$wt/.ai"
  echo "story branch: $story   worktree: $wt"
  echo "source: $src   target: $target"
  echo "== raw commits on the source (do not copy their messages blindly)"
  git -C "$root" log --reverse --format='  %h %s' "$target..$src"
  echo "== changes to tell (git -C $wt diff $target $src -- <file> to read one)"
  git -C "$root" diff --stat "$target" "$src"
  ;;
check)
  story="$(story_branch "${2:-}")"
  src="$(git -C "$root" config "branch.$story.storysource")"
  target="$(git -C "$root" config "branch.$story.storytarget")"
  want="$(git -C "$root" config "branch.$story.storytree")"
  fail=0
  have="$(git -C "$root" rev-parse "$story^{tree}")"
  if [ "$have" = "$want" ]; then echo "end result: IDENTICAL to $src merged onto $target"
  else echo "end result: DIFFERENT. Missing or extra changes:"; git -C "$root" diff --stat "$story" "$want"; fail=1; fi
  n=0
  for c in $(git -C "$root" rev-list --reverse "$target..$story"); do
    n=$((n+1))
    subj="$(git -C "$root" log -1 --format=%s "$c")"
    msg_ok=yes
    echo "$subj" | grep -qE "$SUBJECT_ERE" || msg_ok="no (does not match .ai/commit-style.conf: $COMMIT_STYLE_SOURCE)"
    echo "$subj" | grep -qiE "$BAD_SUBJECT_ERE" && msg_ok="no (wip/fixup/typo-style subject)"
    tmp="$(mktemp -d)"; git -C "$root" worktree add -q --detach "$tmp/wt" "$c"; ln -s "$root/.ai" "$tmp/wt/.ai"
    if (cd "$tmp/wt" && bash .ai/verify.sh --fast >"$tmp/out" 2>&1); then v=PASS; else v=FAIL; fi
    git -C "$root" worktree remove --force "$tmp/wt"; rm -rf "$tmp"
    printf '%2d %s %-4s msg:%s  %s\n' "$n" "$(git -C "$root" rev-parse --short "$c")" "$v" "$msg_ok" "$subj"
    [ "$v" = PASS ] && [ "$msg_ok" = yes ] || fail=1
  done
  [ "$n" -gt 0 ] || { echo "No story commits yet."; fail=1; }
  if [ $fail -eq 0 ]; then echo "story check: PASS"; else echo "story check: FAIL"; exit 1; fi
  ;;
finish)
  story="$(story_branch "${2:-}")"
  target="$(git -C "$root" config "branch.$story.storytarget")"
  bash "$root/.ai/bin/story" check "$story"
  [ "$(git -C "$root" branch --show-current)" = "$target" ] || { echo "Main folder must be on $target." >&2; exit 1; }
  [ -z "$(git -C "$root" status --porcelain --untracked-files=no)" ] || { echo "Uncommitted changes on $target." >&2; exit 1; }
  git -C "$root" merge --ff-only -q "$story"
  echo "Done. $target now tells this story:"
  git -C "$root" log --reverse --format='  %h %s' "ORIG_HEAD..$target"
  ;;
*) echo "usage: story start <ai-branch> | check [story-branch] | finish [story-branch]" >&2; exit 1 ;;
esac
