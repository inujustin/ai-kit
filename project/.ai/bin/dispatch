#!/usr/bin/env bash
# Run one ticket with Codex in a fresh context, directly in the repo on the user's current branch, check it, commit it.
# No clone, no copy: one ticket at a time per checkout (a lock makes parallel dispatches wait their turn).
# Parallel branches only with PARALLEL=worktree in mode.conf: give the branch and it runs in $KIT/worktrees/<branch>.
# Codex edits files and runs tests but cannot commit (its sandbox cannot write .git); this script commits on PASS.
# On FAIL the changes stay uncommitted for Claude to fix or show the user.
# Usage: bash $KIT/.ai/bin/dispatch $KIT/.ai/tickets/T012-foo.md [coder|tester] [branch]
#   tester: writes failing tests only, from the ticket (only when the ticket says "Tests: write").
#   coder:  writes the code (default); if a tester commit for this ticket exists, it may not touch those test files.
# Model: AI_CODEX_MODEL (default gpt-6.1-sol), effort: AI_CODEX_EFFORT (default medium; high for tricky tickets).
# Pick both from the project's BUDGET in mode.conf; ask the user before raising them.
set -euo pipefail
ticket="$(readlink -f "${1:?usage: dispatch <ticket.md> [coder|tester] [branch]}")"
want="${3:-}"
role="${2:-coder}"
case "$role" in coder|tester) ;; *) echo "role must be coder or tester" >&2; exit 1 ;; esac
if [ "$role" = tester ] && ! grep -qiE "Tests:[[:space:]]*write" "$ticket"; then
  echo "This ticket does not say 'Tests: write'. Ask the user whether to write tests for it (bin/test-scan shows what the repo has), record the answer in the ticket, then dispatch the tester." >&2; exit 1
fi
# shellcheck source=/dev/null
. "$(dirname "$0")/../lib.sh"
PROTECTED_BRANCHES='^(main|master|develop|dev|release.*|production|staging)$'; PARALLEL=no
# shellcheck source=/dev/null
[ -f "$KIT/.ai/mode.conf" ] && . "$KIT/.ai/mode.conf"
id="$(basename "$ticket" .md)"
model="${AI_CODEX_MODEL:-gpt-6.1-sol}"
effort="${AI_CODEX_EFFORT:-medium}"
log="$KIT/.ai/logs"; mkdir -p "$log" "$KIT/.ai/run"
name="$id-$role"
TEST_FILES_ERE='(^|/)tests?/'
# shellcheck source=/dev/null
. "$KIT/.ai/packs.conf"

work="$ROOT"
if [ -n "$want" ] && [ "$want" != "$(git -C "$ROOT" branch --show-current)" ]; then
  printf '%s' "$want" | grep -qE "$PROTECTED_BRANCHES" && { echo "'$want' is protected; ask the user which feature branch to use." >&2; exit 1; }
  [ "$PARALLEL" = worktree ] || { echo "Branch '$want' is not the current one and PARALLEL=no: switch first (guard-git asks per BRANCHES), or ask the user to set PARALLEL=worktree." >&2; exit 1; }
  work="$KIT/worktrees/$(printf '%s' "$want" | tr '/' '-')"
  if [ ! -d "$work" ]; then
    mkdir -p "$KIT/worktrees"
    if git -C "$ROOT" rev-parse -q --verify "refs/heads/$want" >/dev/null; then git -C "$ROOT" worktree add -q "$work" "$want"
    else git -C "$ROOT" worktree add -q -b "$want" "$work" "$(cd "$ROOT" && kit_base)"; fi
  fi
fi
exec 9>"$KIT/.ai/run/dispatch-$(printf '%s' "$work" | md5sum | cut -c1-8).lock"
flock 9
cd "$work"
branch="$(git branch --show-current)"
[ -n "$branch" ] || { echo "Not on a branch (detached HEAD). Ask the user which branch to use." >&2; exit 1; }
printf '%s' "$branch" | grep -qE "$PROTECTED_BRANCHES" && { echo "'$branch' is protected; ask the user which feature branch to use." >&2; exit 1; }
[ -z "$(git status --porcelain)" ] || { echo "The working tree has uncommitted changes; commit or ask the user first, so this ticket's diff is only its own." >&2; exit 1; }
start="$(git rev-parse HEAD)"

prompt="Project rules: read CLAUDE.md in the repo (team) and $KIT/AGENTS.md (kit; outside the repo, read-only for you).
The kit gate is: bash $KIT/.ai/verify.sh --fast (run it from $work).

$(cat "$KIT/.ai/roles/$role.md")

Ticket $id:
$(cat "$ticket")"

run_codex() {
  codex exec --sandbox workspace-write -m "$model" -c model_reasoning_effort="$effort" \
    -C "$work" -o "$log/$name.md" "$prompt" >"$log/$name.log" 2>&1 || true
}
run_codex
# Out of quota: only another CODEX account (~/ai-kit/bin/account), never another tool. ROTATE in
# ~/.config/ai-kit/accounts.conf: auto = switch and retry once by itself; anything else = stop and let Claude ask the user.
if grep -qiE 'usage limit|rate limit|quota|too many requests' "$log/$name.log"; then
  acc="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/ai-kit/source" 2>/dev/null)/bin/account"
  ROTATE=ask; [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/ai-kit/accounts.conf" ] && . "${XDG_CONFIG_HOME:-$HOME/.config}/ai-kit/accounts.conf"
  curname="$(awk -F'\t' -v d="${CODEX_HOME:-}" '$1=="codex" && $4==d {print $2}' "${XDG_CONFIG_HOME:-$HOME/.config}/ai-kit/accounts.tsv" 2>/dev/null | tail -1)"
  if [ "$ROTATE" = auto ] && [ -f "$acc" ] && bash "$acc" out codex "${curname:-default}" >/dev/null && next="$(bash "$acc" next codex)"; then
    eval "$(bash "$acc" env codex "$next")"; echo "codex account ${curname:-default} out of quota; retrying on $next" >>"$log/$name.log"
    git checkout -q -- . && git clean -qfd; run_codex
  else
    echo "QUOTA $id ($role): Codex account ${curname:-default} is out of quota. Ask the user: wait, or switch to another Codex account (bash ~/ai-kit/bin/account list) and dispatch again. Changes left as they are."; exit 3
  fi
fi

if bash "$KIT/.ai/verify.sh" --fast >"$log/$name.verify.log" 2>&1; then status=PASS; else status=FAIL; fi

[ -n "$(git status --porcelain)" ] || { echo "FAIL $id ($role) branch=$branch: Codex changed nothing. See $log/$name.md"; exit 1; }
changed="$( { git diff --name-only "$start"; git ls-files --others --exclude-standard; } | sort -u)"
if [ "$role" = tester ]; then
  bad="$(printf '%s\n' "$changed" | grep -vE "$TEST_FILES_ERE" || true)"
  [ -n "$bad" ] && { status=FAIL; echo "tester changed non-test files:"; echo "$bad"; } >>"$log/$name.verify.log"
else
  tc="$(git log --format=%H --grep="^Ticket: $id$" --grep="^Role: tester" --all-match "$start" | head -1)"
  if [ -n "$tc" ]; then
    bad="$(printf '%s\n' "$changed" | grep -Fx -f <(git show --name-only --format= "$tc") || true)"
    [ -n "$bad" ] && { status=FAIL; echo "coder changed test files written by the tester:"; echo "$bad"; } >>"$log/$name.verify.log"
  fi
fi

if [ "$status" = FAIL ]; then
  echo "FAIL $id ($role) branch=$branch: changes left UNCOMMITTED for review. summary=$log/$name.md checks=$log/$name.verify.log"; exit 1
fi
title="$(sed -n '1s/^#* *//p' "$ticket")"
git add -A
git commit -q -m "${title:-$id}" -m "Ticket: $id
Role: $role
Executor: Codex $model ($effort). Checks: PASS"
echo "PASS $id ($role) branch=$branch sha=$(git rev-parse --short HEAD) summary=$log/$name.md checks=$log/$name.verify.log"
